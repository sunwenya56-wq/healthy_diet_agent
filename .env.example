# ---- LLM（不填则默认 Mock 模式，全流程仍可跑通）----
LLM_MOCK=1
LLM_API_KEY=sk-a9e4be5b2e934a21bb7d84a460e4ef1a
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 多模态（0 = 使用真实 pytesseract / ultralytics）----
VISION_MOCK=1
YOLO_MODEL_PATH=./models/best.pt

# ---- 语音转写（硅基流动 ASR，不填则回退样例文本）----
SILICONFLOW_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=XingChenAGI/XingChenGSR-V1.0

# ---- 存储 ----
DATABASE_URL=sqlite:///./data/diet.db
# MySQL 示例：DATABASE_URL=mysql+pymysql://root:pass@127.0.0.1:3306/diet?charset=utf8mb4
VECTOR_BACKEND=memory          # memory | milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=diet_guidelines           # 膳食指南知识库
MILVUS_HISTORY_COLLECTION=user_history      # 用户历史交互记忆

# ---- Agent 行为 ----
MAX_REVISIONS=2
MIN_QUALITY_SCORE=80
